# Copy this file to .env and fill in real values. The app itself is fully
# client-side (React state + localStorage) — the only backend feature it
# actually calls is the Google Drive sync (/api/drive-sync/*), so these are
# the only variables that matter for self-hosting.

# PORT: which port the standalone server (scripts/standalone-server.ts) listens
# on. Defaults to 8080 if unset.
PORT=8080

# Google Drive sync (mirrors accounts/attendance/lessons+questions into CSV
# files in a shared Drive folder). Create a Google Service Account, download
# its JSON key, then share the target Drive folder with the service account's
# client_email as an Editor. Optional — the app works fine without it, just
# without the Drive backup/sync feature.
GOOGLE_SERVICE_ACCOUNT_EMAIL="my-service-account@my-project.iam.gserviceaccount.com"
# Paste the JSON key's "private_key" value; keep the \n escape sequences as-is.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# Drive folder ID from its URL (defaults to the shared AN TÂM sync folder if unset).
SYNC_DRIVE_FOLDER_ID="1pe_shunN1J9-ZrqVyYIBu5zxlFeuWRYL"
# Optional shared secret required in the x-sync-secret header (light deterrent only).
ACCOUNTS_SHEET_SYNC_SECRET="MY_SYNC_SECRET"
